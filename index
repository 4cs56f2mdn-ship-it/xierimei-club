<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#071a2f">
  <meta name="color-scheme" content="light">
  <title>广深港澳｜2026 年 8 月 20 日出发</title>
  <style>
    :root {
      --ink: #102033;
      --muted: #607086;
      --line: rgba(22, 59, 91, 0.12);
      --paper: rgba(255, 255, 255, 0.82);
      --paper-solid: #ffffff;
      --navy: #071a2f;
      --blue: #0a65d8;
      --teal: #0da7a0;
      --green: #198754;
      --amber: #a75d00;
      --red: #b42318;
      --shadow: 0 18px 55px rgba(15, 47, 76, 0.12);
      --shadow-soft: 0 8px 28px rgba(15, 47, 76, 0.08);
      --radius-xl: 30px;
      --radius-lg: 22px;
      --radius-md: 16px;
      --safe-bottom: max(18px, env(safe-area-inset-bottom));
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      background: #edf5f7;
    }

    body {
      margin: 0;
      color: var(--ink);
      background:
        radial-gradient(circle at 10% 5%, rgba(44, 151, 211, 0.17), transparent 30rem),
        radial-gradient(circle at 92% 18%, rgba(16, 178, 163, 0.14), transparent 27rem),
        linear-gradient(180deg, #edf6f8 0%, #f7f9fb 42%, #eef4f6 100%);
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "PingFang SC", "Microsoft YaHei", sans-serif;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    a { color: inherit; }
    button, summary { font: inherit; }

    .shell {
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
      padding: 22px 0 calc(104px + var(--safe-bottom));
    }

    .topbar {
      position: sticky;
      top: 12px;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 16px;
      padding: 11px 12px 11px 18px;
      border: 1px solid rgba(255, 255, 255, 0.65);
      border-radius: 999px;
      background: rgba(247, 252, 253, 0.76);
      box-shadow: 0 10px 35px rgba(17, 52, 78, 0.09);
      backdrop-filter: blur(18px) saturate(150%);
      -webkit-backdrop-filter: blur(18px) saturate(150%);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      font-size: 14px;
      font-weight: 760;
      letter-spacing: .02em;
    }

    .brand-mark {
      width: 30px;
      height: 30px;
      border-radius: 10px;
      background: linear-gradient(145deg, #0d6de5, #0bb1a7);
      box-shadow: 0 7px 17px rgba(10, 101, 216, .28);
    }

    .topnav {
      display: flex;
      gap: 4px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .topnav::-webkit-scrollbar { display: none; }

    .topnav a {
      flex: 0 0 auto;
      padding: 8px 11px;
      border-radius: 999px;
      color: #41536a;
      font-size: 12px;
      font-weight: 680;
      text-decoration: none;
    }

    .topnav a:hover,
    .topnav a:focus-visible {
      color: #074d9f;
      background: rgba(10, 101, 216, .08);
      outline: none;
    }

    .hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      min-height: 440px;
      padding: clamp(30px, 6vw, 66px);
      border: 1px solid rgba(255, 255, 255, .28);
      border-radius: var(--radius-xl);
      color: white;
      background:
        radial-gradient(circle at 82% 13%, rgba(50, 239, 203, .27), transparent 24rem),
        radial-gradient(circle at 12% 100%, rgba(27, 127, 236, .38), transparent 28rem),
        linear-gradient(135deg, #06172a 0%, #06335d 50%, #087d87 100%);
      box-shadow: 0 30px 80px rgba(8, 46, 75, .28);
    }

    .hero::after {
      content: "";
      position: absolute;
      z-index: -1;
      right: -90px;
      bottom: -135px;
      width: 390px;
      height: 390px;
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 50%;
      box-shadow: 0 0 0 56px rgba(255,255,255,.035), 0 0 0 112px rgba(255,255,255,.025);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 18px;
      padding: 8px 12px;
      border: 1px solid rgba(255,255,255,.22);
      border-radius: 999px;
      background: rgba(255,255,255,.1);
      color: rgba(255,255,255,.9);
      font-size: 12px;
      font-weight: 720;
      letter-spacing: .08em;
      backdrop-filter: blur(12px);
    }

    .eyebrow::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #54e8ce;
      box-shadow: 0 0 0 5px rgba(84,232,206,.13);
    }

    h1 {
      margin: 0;
      font-size: clamp(58px, 11vw, 116px);
      line-height: .92;
      letter-spacing: -.075em;
      font-weight: 820;
    }

    .hero-subtitle {
      width: min(680px, 100%);
      margin: 26px 0 0;
      color: rgba(255,255,255,.78);
      font-size: clamp(16px, 2.4vw, 22px);
      line-height: 1.6;
      letter-spacing: -.015em;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 32px;
    }

    .hero-chip {
      padding: 10px 13px;
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 13px;
      background: rgba(255,255,255,.095);
      color: rgba(255,255,255,.88);
      font-size: 13px;
      font-weight: 670;
      backdrop-filter: blur(10px);
    }

    .hero-chip strong { color: white; }

    .section {
      scroll-margin-top: 92px;
      margin-top: 28px;
    }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin: 0 4px 14px;
    }

    .section-heading h2 {
      margin: 0;
      color: #10263e;
      font-size: clamp(24px, 4vw, 36px);
      line-height: 1.1;
      letter-spacing: -.04em;
    }

    .section-heading p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
    }

    .glass {
      border: 1px solid rgba(255,255,255,.8);
      border-radius: var(--radius-lg);
      background: var(--paper);
      box-shadow: var(--shadow-soft);
      backdrop-filter: blur(18px) saturate(130%);
      -webkit-backdrop-filter: blur(18px) saturate(130%);
    }

    .route-panel {
      display: grid;
      grid-template-columns: 1.25fr .75fr;
      gap: 16px;
    }

    .route-card { padding: 24px; }

    .route-flow {
      display: flex;
      align-items: center;
      gap: 10px;
      overflow-x: auto;
      padding: 4px 1px 10px;
      scrollbar-width: thin;
    }

    .route-stop {
      flex: 0 0 auto;
      min-width: 92px;
      padding: 13px 14px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: rgba(255,255,255,.72);
      text-align: center;
    }

    .route-stop span {
      display: block;
      color: var(--muted);
      font-size: 11px;
      margin-bottom: 3px;
    }

    .route-stop strong { font-size: 15px; }
    .route-arrow { color: #6b8198; font-size: 17px; }

    .hotel-list {
      display: grid;
      gap: 12px;
      margin-top: 18px;
    }

    .hotel {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 12px;
      align-items: center;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: rgba(255,255,255,.58);
    }

    .hotel-icon {
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      border-radius: 12px;
      color: #0b5ebd;
      background: rgba(10,101,216,.1);
      font-weight: 800;
    }

    .hotel strong { display: block; font-size: 14px; line-height: 1.45; }
    .hotel small { color: var(--muted); font-size: 12px; }

    .mini-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 36px;
      padding: 8px 11px;
      border: 1px solid rgba(10,101,216,.15);
      border-radius: 11px;
      color: #0757ae;
      background: rgba(10,101,216,.07);
      font-size: 12px;
      font-weight: 720;
      text-decoration: none;
    }

    .alert-card {
      padding: 24px;
      color: #fff;
      background: linear-gradient(150deg, #0f2740 0%, #134665 100%);
      box-shadow: 0 18px 48px rgba(15, 39, 64, .2);
    }

    .alert-kicker {
      color: #71e1d0;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .alert-card h3 {
      margin: 8px 0 17px;
      font-size: 23px;
      letter-spacing: -.03em;
    }

    .redline {
      display: grid;
      grid-template-columns: 58px 1fr;
      gap: 12px;
      align-items: start;
      padding: 14px 0;
      border-top: 1px solid rgba(255,255,255,.12);
    }

    .redline time {
      color: #fff;
      font-size: 18px;
      font-weight: 820;
      letter-spacing: -.03em;
    }

    .redline p {
      margin: 1px 0 0;
      color: rgba(255,255,255,.72);
      font-size: 13px;
      line-height: 1.5;
    }

    .ticket-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .ticket {
      position: relative;
      overflow: hidden;
      padding: 22px;
    }

    .ticket::after {
      content: "";
      position: absolute;
      right: -30px;
      top: -30px;
      width: 105px;
      height: 105px;
      border-radius: 50%;
      background: rgba(13,167,160,.07);
    }

    .ticket-head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
    }

    .ticket-date { color: var(--muted); font-size: 12px; font-weight: 700; }

    .status {
      position: relative;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 9px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 780;
    }

    .status.ok { color: #126a46; background: rgba(25,135,84,.11); }
    .status.wait { color: #8b5105; background: rgba(240,158,39,.14); }

    .train-no {
      margin-top: 15px;
      color: #0a59b7;
      font-size: 28px;
      font-weight: 850;
      letter-spacing: -.04em;
    }

    .ticket-time {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 8px;
      margin-top: 15px;
    }

    .ticket-time .end { text-align: right; }
    .ticket-time strong { display: block; font-size: 21px; letter-spacing: -.04em; }
    .ticket-time small { color: var(--muted); font-size: 11px; }
    .ticket-line { color: #7690a8; font-size: 11px; text-align: center; white-space: nowrap; }
    .ticket-foot { margin: 15px 0 0; color: var(--muted); font-size: 12px; line-height: 1.55; }

    .btn-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 15px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 10px 13px;
      border: 1px solid rgba(10,101,216,.15);
      border-radius: 12px;
      color: #0757ae;
      background: rgba(10,101,216,.07);
      font-size: 12px;
      font-weight: 760;
      text-decoration: none;
    }

    .btn.primary {
      color: white;
      border-color: transparent;
      background: linear-gradient(135deg, #0a65d8, #078a9f);
    }

    .days {
      display: grid;
      gap: 14px;
    }

    details.day {
      overflow: clip;
      border: 1px solid rgba(255,255,255,.82);
      border-radius: var(--radius-lg);
      background: rgba(255,255,255,.82);
      box-shadow: var(--shadow-soft);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    details.day[open] {
      background: rgba(255,255,255,.94);
      box-shadow: var(--shadow);
    }

    summary.day-head {
      display: grid;
      grid-template-columns: 86px 1fr auto;
      gap: 18px;
      align-items: center;
      padding: 21px 22px;
      cursor: pointer;
      list-style: none;
      user-select: none;
    }

    summary.day-head::-webkit-details-marker { display: none; }

    summary.day-head:focus-visible {
      outline: 3px solid rgba(10,101,216,.22);
      outline-offset: -3px;
    }

    .day-number {
      color: #0a5cbf;
      font-size: 12px;
      font-weight: 820;
      letter-spacing: .08em;
      text-transform: uppercase;    }

    .day-number strong {
      display: block;
      margin-top: 3px;
      color: #193652;
      font-size: 22px;
      letter-spacing: -.04em;
    }

    .day-title h3 {
      margin: 0;
      color: #10263e;
      font-size: 20px;
      line-height: 1.25;
      letter-spacing: -.025em;
    }

    .day-title p { margin: 5px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; }

    .chevron {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      color: #35617e;
      background: #edf5f8;
      transition: transform .24s ease, background .24s ease;
    }

    details[open] .chevron { transform: rotate(45deg); background: #e4f3f2; }

    .day-body {
      padding: 2px 22px 24px;
      border-top: 1px solid var(--line);
    }

    .callout {
      margin: 18px 0 6px;
      padding: 15px 17px;
      border: 1px solid rgba(10,101,216,.12);
      border-radius: 15px;
      color: #234660;
      background: linear-gradient(135deg, rgba(10,101,216,.07), rgba(13,167,160,.07));
      font-size: 13px;
      line-height: 1.65;
    }

    .callout strong { color: #0758ad; }
    .callout.warning { border-color: rgba(180,35,24,.14); color: #703027; background: rgba(180,35,24,.06); }
    .callout.warning strong { color: var(--red); }

    .timeline {
      position: relative;
      margin: 18px 0 0;
      padding: 0;
      list-style: none;
    }

    .timeline::before {
      content: "";
      position: absolute;
      left: 72px;
      top: 9px;
      bottom: 12px;
      width: 1px;
      background: linear-gradient(#8cb5d4, rgba(140,181,212,.12));
    }

    .timeline li {
      position: relative;
      display: grid;
      grid-template-columns: 58px 1fr;
      gap: 28px;
      padding: 0 0 20px;
    }

    .timeline time {
      padding-top: 2px;
      color: #0b62c9;
      font-size: 13px;
      font-weight: 820;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .timeline li::before {
      content: "";
      position: absolute;
      left: 67px;
      top: 6px;
      width: 9px;
      height: 9px;
      border: 3px solid #fff;
      border-radius: 50%;
      background: #0a70d8;
      box-shadow: 0 0 0 1px rgba(10,112,216,.18);
    }

    .step { min-width: 0; }
    .step h4 { margin: 0; color: #18344f; font-size: 15px; line-height: 1.45; }
    .step p { margin: 5px 0 0; color: var(--muted); font-size: 13px; line-height: 1.62; }

    .tag-row { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 9px; }
    .tag { padding: 6px 8px; border-radius: 8px; color: #456177; background: #eef4f7; font-size: 11px; font-weight: 680; }
    .tag.hard { color: #8f2c21; background: rgba(180,35,24,.08); }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .info-card { padding: 20px; }
    .info-card h3 { margin: 0 0 11px; font-size: 17px; letter-spacing: -.02em; }
    .info-card ul { margin: 0; padding: 0 0 0 18px; color: var(--muted); }
    .info-card li { margin: 8px 0; font-size: 13px; line-height: 1.55; }

    .admission-grid,
    .meal-grid,
    .group-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .admission-card,
    .meal-card,
    .role-card { padding: 20px; }

    .card-kicker {
      display: inline-flex;
      margin-bottom: 8px;
      padding: 5px 8px;
      border-radius: 999px;
      color: #0757ae;
      background: rgba(10,101,216,.08);
      font-size: 10px;
      font-weight: 820;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .admission-card h3,
    .meal-card h3,
    .role-card h3 { margin: 0; color: #16344f; font-size: 17px; line-height: 1.4; letter-spacing: -.02em; }

    .admission-lines { display: grid; gap: 8px; margin-top: 13px; }

    .admission-line {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 10px;
      padding-top: 8px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 12px;
      line-height: 1.55;
    }

    .admission-line strong { color: #284963; }
    .admission-note,
    .meal-card p,
    .role-card p { margin: 11px 0 0; color: var(--muted); font-size: 12px; line-height: 1.65; }
    .meal-card ul,
    .role-card ul { margin: 11px 0 0; padding-left: 18px; color: var(--muted); }
    .meal-card li,
    .role-card li { margin: 7px 0; font-size: 12px; line-height: 1.6; }

    .meal-price {
      display: inline-block;
      margin-top: 12px;
      color: #0d6b57;
      font-size: 12px;
      font-weight: 780;
    }

    .food-13 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin: 0;
      padding: 18px;
      list-style: none;
    }

    .food-13 li {
      padding: 15px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: rgba(255,255,255,.66);
    }

    .food-13 strong { display: block; color: #183d59; font-size: 14px; line-height: 1.45; }
    .food-13 p { margin: 6px 0 0; color: var(--muted); font-size: 11px; line-height: 1.65; }
    .food-status { display: inline-flex; margin-top: 9px; padding: 5px 7px; border-radius: 7px; color: #116a50; background: rgba(25,135,84,.1); font-size: 10px; font-weight: 800; }
    .food-status.alt { color: #81530c; background: rgba(240,158,39,.13); }

    .micro-note {
      margin: 14px 0 0;
      color: #6d7d90;
      font-size: 11px;
      line-height: 1.65;
    }

    .checklist {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      padding: 18px;
    }

    .check {
      display: grid;
      grid-template-columns: 26px 1fr;
      gap: 10px;
      align-items: start;
      padding: 13px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: rgba(255,255,255,.66);
    }

    .check-box {
      display: grid;
      place-items: center;
      width: 24px;
      height: 24px;
      border: 1.5px solid #8ca2b5;
      border-radius: 8px;
      color: #758ca0;
      font-size: 11px;
      font-weight: 850;
    }

    .check strong { display: block; font-size: 13px; }
    .check small { display: block; margin-top: 4px; color: var(--muted); font-size: 11px; line-height: 1.5; }

    .source-links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 18px;
    }

    .source-links a {
      padding: 9px 11px;
      border: 1px solid var(--line);
      border-radius: 11px;
      color: #2e5874;
      background: rgba(255,255,255,.65);
      font-size: 12px;
      font-weight: 680;
      text-decoration: none;
    }

    .source-links a:hover { color: #0757ae; border-color: rgba(10,101,216,.22); }

    .footnote {
      margin: 28px 0 0;
      color: #728195;
      font-size: 11px;
      line-height: 1.65;
      text-align: center;
    }

    .dock {
      position: fixed;
      z-index: 30;
      left: 50%;
      bottom: var(--safe-bottom);
      transform: translateX(-50%);
      display: flex;
      gap: 4px;
      max-width: calc(100% - 24px);
      padding: 7px;
      border: 1px solid rgba(255,255,255,.72);
      border-radius: 18px;
      background: rgba(245,250,251,.85);
      box-shadow: 0 16px 46px rgba(16,49,72,.17);
      backdrop-filter: blur(20px) saturate(160%);
      -webkit-backdrop-filter: blur(20px) saturate(160%);
    }

    .dock a {
      flex: 0 0 auto;
      min-width: 70px;
      padding: 9px 11px;
      border-radius: 12px;
      color: #3d566d;
      font-size: 11px;
      font-weight: 760;
      text-align: center;
      text-decoration: none;
    }

    .dock a:hover,
    .dock a:focus-visible { color: white; background: linear-gradient(135deg, #0a65d8, #078a9f); outline: none; }

    @media (max-width: 820px) {
      .shell { width: min(100% - 22px, 720px); padding-top: 12px; }
      .topbar { top: 8px; padding-left: 13px; }
      .brand span { display: none; }
      .hero { min-height: 400px; border-radius: 25px; }
      .route-panel, .ticket-grid, .info-grid, .admission-grid, .meal-grid, .group-grid, .food-13 { grid-template-columns: 1fr; }
      .ticket-grid { gap: 11px; }
      .ticket { display: grid; grid-template-columns: 1fr; }
